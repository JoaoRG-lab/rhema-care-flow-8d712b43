modules = ["nodejs-22", "python-3.12"]
run = "npm run dev -- --host 0.0.0.0 --port 5173"

[deployment]
run = ["sh", "-c", "npm ci && npm run build && npm run preview -- --host 0.0.0.0 --port 4173"]

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 4173
externalPort = 3000

[env]
RHEMA_ENGINE_MODE = "replit-preview"
